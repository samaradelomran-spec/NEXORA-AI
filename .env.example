NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY

# Optional AI provider keys (server-side only)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.2-sol
OPENAI_IMAGE_MODEL=gpt-image-2.5-flare
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
GOOGLE_AI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
GEMINI_TTS_MODEL=gemini-3.1-flash-tts-preview
GEMINI_TTS_VOICE=Kore

# Additional providers for image, video and audio workflows
FAL_KEY=
FAL_VIDEO_MODEL=your-account/model-endpoint
FAL_VIDEO_RESOLUTION_FIELD=resolution
STABILITY_API_KEY=
RUNWAY_API_KEY=
RUNWAY_VIDEO_MODEL=seedance2_5
RUNWAY_MUSIC_MODEL=eleven_music_v2_5
KLING_API_KEY=
LUMA_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_DEFAULT_VOICE_ID=
ELEVENLABS_MODEL=eleven_v4
DEEPGRAM_API_KEY=
ASSEMBLYAI_API_KEY=

# Payment provider (remains inactive until credentials, price ID, webhook, and a test payment are configured)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=

# Admin dashboard (server-only secrets; never expose in NEXT_PUBLIC variables)
SUPABASE_SERVICE_ROLE_KEY=
NEXORA_ADMIN_EMAILS=
