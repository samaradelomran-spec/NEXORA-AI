NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY

# Text and image generation
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.2-sol
OPENAI_IMAGE_MODEL=gpt-image-2.5-flare
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-large-latest
GOOGLE_AI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
GEMINI_VIDEO_MODEL=gemini-omni-1.2-flash
GEMINI_TTS_MODEL=gemini-3.8-flash-tts
GEMINI_TTS_VOICE=Kore
STABILITY_API_KEY=
STABILITY_IMAGE_ENDPOINT=ultra
FAL_KEY=
FAL_IMAGE_MODEL=fal-ai/flux-2-pro

# Video, music and sound effects
FAL_VIDEO_MODEL=
FAL_VIDEO_RESOLUTION_FIELD=resolution
FAL_VIDEO_DURATION_FIELD=duration
FAL_VIDEO_DEFAULT_PARAMS={}
RUNWAY_API_KEY=
RUNWAY_VIDEO_MODEL=seedance2_5
RUNWAY_MUSIC_MODEL=eleven_music_v2_5
RUNWAY_SFX_MODEL=eleven_text_to_sound_v2
LUMA_API_KEY=
LUMA_VIDEO_MODEL=ray-2

# Voice generation
ELEVENLABS_API_KEY=
ELEVENLABS_DEFAULT_VOICE_ID=
ELEVENLABS_MODEL=eleven_v4

# Payments (inactive until account, price, webhook, and test payment are configured)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=

# Admin (server-only; never use NEXT_PUBLIC_ for these)
SUPABASE_SERVICE_ROLE_KEY=
NEXORA_ADMIN_EMAILS=
